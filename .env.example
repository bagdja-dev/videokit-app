# ─────────────────────────────────────────────────────────────────────────────────────────────
# bagdja-videokit-app — contoh env. Situs statis: TIDAK ADA secret di app (secret hanya di videokit-api).
# Lokal   : salin ke .env.local (tidak di-commit).
# Coolify : isi di Environment Variables resource app dengan centang "Build Variable" (Dockerfile memakai ARG),
#           lalu Redeploy. NEXT_PUBLIC_* di-inline saat BUILD — mengubahnya butuh build ulang.
# ─────────────────────────────────────────────────────────────────────────────────────────────

# URL videokit-api (BFF login SSO + avatar).
#   Produksi (Coolify): https://videokit-api.bagdja.com
#   Lokal: kosongkan → host yang sama dengan app, port 5031 (juga berlaku saat dibuka lewat IP LAN).
# PENTING: app & API harus satu situs (*.bagdja.com) agar cookie sesi terkirim — login tidak jalan di domain lain
# (mis. domain sementara *.sslip.io bawaan Coolify).
NEXT_PUBLIC_VIDEOKIT_API_URL=

# Build produksi tanpa sampel dev (avatar contoh). Sudah diset di Dockerfile — tidak perlu diisi di Coolify.
VK_SKIP_DEV_SAMPLES=

# KHUSUS `npm run dev`: `mock` = lewati login SSO dengan akun tiruan "dev-lokal". Diabaikan di build produksi.
NEXT_PUBLIC_VK_DEV_AUTH=

# KHUSUS `npm run dev`: origin tambahan (dipisah koma) yang boleh mengakses dev server, bila IP LAN otomatis tidak cukup.
VK_DEV_ORIGINS=

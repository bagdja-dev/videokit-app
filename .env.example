# URL bagdja-videokit-api (BFF login SSO). Diset saat build produksi, mis. https://api-videokit.bagdja.com
# Kosong saat development → host yang sama dengan app, port 5031 (berlaku juga untuk akses lewat IP LAN).
NEXT_PUBLIC_VIDEOKIT_API_URL=

# KHUSUS development (`npm run dev`): `mock` = lewati login SSO dengan akun tiruan "dev-lokal". Diabaikan di build
# produksi. Taruh di .env.local (tidak di-commit).
NEXT_PUBLIC_VK_DEV_AUTH=

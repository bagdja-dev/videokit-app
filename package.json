{
  "name": "bagdja-videokit-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor-jassub.mjs && node scripts/fetch-fonts-cjk.mjs",
    "predev": "npm run vendor",
    "dev": "next dev --webpack",
    "predev:https": "npm run vendor",
    "dev:https": "node scripts/dev-https.mjs",
    "prebuild": "npm run vendor",
    "build": "next build --webpack",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "samples": "node scripts/make-dev-samples.mjs",
    "e2e:render": "node scripts/e2e-render.mjs",
    "e2e:editor": "node scripts/e2e-editor.mjs"
  },
  "dependencies": {
    "jassub": "2.5.23",
    "mediabunny": "1.65.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
